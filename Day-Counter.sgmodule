#!name=Surge Day Counter v1.4
#!desc=简洁正计时，仅显示题目与天数。起始日计为第1天；北京时间换日。脚本须位于配置目录。
#!arguments=title:每一天都算数,start_date:2026-07-24
#!arguments-desc=title 为题目；start_date 为起始日期，格式 YYYY-MM-DD。题目请勿使用英文双引号、逗号或换行。修改后刷新面板。

[Panel]
DayCounter = title="每一天都算数",content="轻点刷新",script-name=DayCounterScript,update-interval=1

[Script]
DayCounterScript = type=generic,script-path=https://raw.githubusercontent.com/zhurant/Surge-Day-Counter/refs/heads/main/Day-Counter.js,timeout=5,argument="{{{start_date}}}|{{{title}}}"
